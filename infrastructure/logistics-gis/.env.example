# Source this file in the supervised shell that runs GIS operations.
# It contains no application secrets. Replace placeholders only after auditing
# the actual production host and installed native tools.
GIS_BASE_DIR=/srv/pischeprom-gis
GIS_PBF_URL=https://download.geofabrik.de/russia-latest.osm.pbf
GIS_PBF_MD5_URL=https://download.geofabrik.de/russia-latest.osm.pbf.md5
GIS_PBF_INDEX_URL=https://download.geofabrik.de/russia.html
GIS_APP_DISK_RESERVE_BYTES=21474836480
GIS_APP_RAM_RESERVE_BYTES=2147483648
GIS_PLANETILER_DISK_MULTIPLIER=10
GIS_PLANETILER_RAM_MULTIPLIER=0.5
GIS_VALHALLA_GRAPH_MULTIPLIER=3
GIS_VALHALLA_RAM_MULTIPLIER=0.75
GIS_PMTILES_MULTIPLIER=1.5
GIS_WARN_LOAD_PER_CORE=0.7
GIS_FAIL_LOAD_PER_CORE=1.0
# Keep true on production. Set false only on an isolated temporary build host.
GIS_REQUIRE_CURRENT_VALHALLA_HEALTH=true
# Required for the first activation only when the registered legacy current
# release manifest does not already contain osm_data_version.
GIS_CURRENT_OSM_DATA_VERSION=
GIS_BUILD_NICE=10
GIS_BUILD_IONICE=7

VALHALLA_STATUS_URL=http://127.0.0.1:8002/status
VALHALLA_EXPECTED_VERSION=3.6.3
# Native host default. A container-private 0.0.0.0 bind needs the explicit
# opt-in below and must still publish/firewall the host port as loopback-only.
VALHALLA_SERVICE_LISTEN=tcp://127.0.0.1:8002
VALHALLA_ALLOW_WILDCARD_LISTEN=false
# Required: exact existing unit from the audited production host; no default is assumed.
VALHALLA_SYSTEMD_UNIT=
# Alternative adapter for the already deployed runtime (for example, an existing
# compose-based service). The helper must restart it and return a truthful code.
VALHALLA_RESTART_HELPER=
VALHALLA_SMOKE_PORT=18002

PLANETILER_JAR=/opt/planetiler/planetiler.jar
PLANETILER_VERSION=
PLANETILER_JAR_SHA256=
GIS_PMTILES_CLI_VERSION=
GIS_MAP_ASSETS_DIR=/opt/pischeprom-map-assets

# Required only for activation checks.
GIS_PUBLIC_PMTILES_URL=https://example.invalid/maps/logistics/russia.pmtiles
GIS_LARAVEL_APP_DIR=/srv/pischeprom/current

[Unit]
Description=Pischeprom private Valhalla routing service
After=network-online.target
Wants=network-online.target

[Service]
# Reference for adapting the already deployed unit. Do not install a second
# permanent Valhalla service alongside a healthy existing runtime.
Type=simple
User=pischeprom-gis
Group=pischeprom-gis
EnvironmentFile=-/etc/pischeprom-gis.env
ExecStart=/usr/local/bin/valhalla_service /srv/pischeprom-gis/current/valhalla/valhalla.json 4
Restart=always
RestartSec=5
TimeoutStopSec=45
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/srv/pischeprom-gis

[Install]
WantedBy=multi-user.target

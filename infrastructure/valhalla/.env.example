# Copy to .env on the routing host. No secrets are required.
VALHALLA_IMAGE=ghcr.io/valhalla/valhalla-scripted:3.6.3
VALHALLA_PORT=8002
VALHALLA_SERVER_THREADS=4
VALHALLA_BUILD_THREADS=4

# Both district extracts must use this same immutable Geofabrik snapshot.
OSM_SNAPSHOT=260725

# Normally managed by scripts/activate-graph.sh.
VALHALLA_ACTIVE_GRAPH=./data/current

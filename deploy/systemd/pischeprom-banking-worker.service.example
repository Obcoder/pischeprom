[Unit]
Description=Pischeprom Laravel banking queue worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=forge
Group=forge
WorkingDirectory=/home/forge/xn----dtbhbbn3apgclecj7i.xn--p1ai
ExecStart=/usr/bin/php artisan queue:work redis --queue=banking --sleep=3 --tries=5 --timeout=1800 --max-time=3600
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=1830
UMask=0027
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

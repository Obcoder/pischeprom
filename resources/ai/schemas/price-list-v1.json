{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["document", "column_mapping", "items", "warnings"],
  "properties": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["is_price_list", "supplier_name", "supplier_inn", "default_currency", "default_vat_mode", "default_vat_rate", "valid_from", "valid_to", "notes"],
      "properties": {
        "is_price_list": {"type": "boolean"},
        "supplier_name": {"type": ["string", "null"], "maxLength": 255},
        "supplier_inn": {"type": ["string", "null"], "pattern": "^[0-9]{10,12}$"},
        "default_currency": {"type": ["string", "null"], "pattern": "^[A-Z]{3}$"},
        "default_vat_mode": {"type": "string", "enum": ["included", "excluded", "unknown"]},
        "default_vat_rate": {"type": ["string", "null"], "pattern": "^[0-9]{1,2}(\\.[0-9]{1,4})?$"},
        "valid_from": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "valid_to": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "notes": {"type": ["string", "null"], "maxLength": 2000}
      }
    },
    "column_mapping": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_column", "target_field", "confidence"],
        "properties": {
          "source_column": {"type": "string", "maxLength": 64},
          "target_field": {"type": "string", "maxLength": 64},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "items": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_locator", "raw_text", "supplier_sku", "manufacturer_sku", "barcode", "name", "manufacturer", "brand", "country_of_origin", "package_description", "units_per_package", "net_quantity", "net_quantity_unit", "price_basis_quantity", "price_basis_unit", "minimum_order_quantity", "price", "currency", "vat_mode", "vat_rate", "availability", "valid_from", "valid_to", "notes", "field_evidence", "warnings"],
        "properties": {
          "source_locator": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sheet", "page", "table", "row", "cells"],
            "properties": {
              "sheet": {"type": ["string", "null"], "maxLength": 128},
              "page": {"type": ["integer", "null"], "minimum": 1},
              "table": {"type": ["integer", "null"], "minimum": 1},
              "row": {"type": ["integer", "null"], "minimum": 1},
              "cells": {"type": ["string", "null"], "maxLength": 128}
            }
          },
          "raw_text": {"type": "string", "maxLength": 5000},
          "supplier_sku": {"type": ["string", "null"], "maxLength": 191},
          "manufacturer_sku": {"type": ["string", "null"], "maxLength": 191},
          "barcode": {"type": ["string", "null"], "maxLength": 64},
          "name": {"type": "string", "minLength": 1, "maxLength": 255},
          "manufacturer": {"type": ["string", "null"], "maxLength": 255},
          "brand": {"type": ["string", "null"], "maxLength": 255},
          "country_of_origin": {"type": ["string", "null"], "maxLength": 255},
          "package_description": {"type": ["string", "null"], "maxLength": 255},
          "units_per_package": {"type": ["string", "null"], "pattern": "^[0-9]+(\\.[0-9]{1,6})?$"},
          "net_quantity": {"type": ["string", "null"], "pattern": "^[0-9]+(\\.[0-9]{1,6})?$"},
          "net_quantity_unit": {"type": ["string", "null"], "enum": ["kg", "g", "l", "ml", "pcs", "box", null]},
          "price_basis_quantity": {"type": ["string", "null"], "pattern": "^[0-9]+(\\.[0-9]{1,6})?$"},
          "price_basis_unit": {"type": ["string", "null"], "enum": ["kg", "g", "l", "ml", "pcs", "box", null]},
          "minimum_order_quantity": {"type": ["string", "null"], "pattern": "^[0-9]+(\\.[0-9]{1,6})?$"},
          "price": {"type": ["string", "null"], "pattern": "^[0-9]+(\\.[0-9]{1,6})?$"},
          "currency": {"type": ["string", "null"], "pattern": "^[A-Z]{3}$"},
          "vat_mode": {"type": "string", "enum": ["included", "excluded", "unknown"]},
          "vat_rate": {"type": ["string", "null"], "pattern": "^[0-9]{1,2}(\\.[0-9]{1,4})?$"},
          "availability": {"type": ["string", "null"], "maxLength": 255},
          "valid_from": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "valid_to": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "notes": {"type": ["string", "null"], "maxLength": 2000},
          "field_evidence": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["field", "source", "confidence"],
              "properties": {
                "field": {"type": "string", "maxLength": 64},
                "source": {"type": "string", "maxLength": 500},
                "confidence": {"type": "number", "minimum": 0, "maximum": 1}
              }
            }
          },
          "warnings": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 255}}
        }
      }
    },
    "warnings": {"type": "array", "maxItems": 100, "items": {"type": "string", "maxLength": 500}}
  }
}
